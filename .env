# OpenClaw 环境变量配置文件
# 复制此文件为 .env 并填写实际值

# ============================================
# 数据目录配置
# ============================================
OPENCLAW_DATA_DIR=/data/openclaw

# ============================================
# LLM Provider 配置 (通用)
# ============================================
# Provider ID: dashscope, openai, anthropic, google, etc.
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
LLM_API_KEY=433e9e9471f04d3c8e286cf84f137800.ttVPWJgPniJHjYZp
LLM_MODEL_ID=claude-opus-4-5
LLM_API_TYPE=anthropic-messages

# 其他 Provider 示例:
# OpenAI:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-your-openai-key
#   LLM_MODEL_ID=gpt-4
#   LLM_API_TYPE=openai-completions
#
# Anthropic:
#   LLM_PROVIDER=anthropic
#   LLM_BASE_URL=https://api.anthropic.com
#   LLM_API_KEY=sk-ant-your-key
#   LLM_MODEL_ID=claude-sonnet-4-5
#   LLM_API_TYPE=anthropic

# ============================================
# 企业微信配置
# ============================================
WECOM_TOKEN=dje69wCBT5C
WECOM_ENCODING_AES_KEY=PMrut6zH1zHdj8YqwWqgh6XcYxofI0TJcxrYmpm22x2

# ============================================
# Vapi Phone Call Configuration
# ============================================
VAPI_API_KEY=217221a2-4115-4160-9d85-4789dcad0a45
VAPI_PHONE_NUMBER_ID=fcedcc39-c2b3-44ac-a83d-8d15f402ecb6
VAPI_WEBHOOK_URL=https://openclawsg.q-vision.com.cn/webhooks/vapi

# ============================================
# Gateway 配置
# ============================================
GATEWAY_PORT=18789
GATEWAY_MODE=local
GATEWAY_BIND=lan
GATEWAY_AUTH_TOKEN=openclaw-auth-token-2025

# ============================================
# Docker 配置
# ============================================
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:main
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000
DOCKER_GID=114

# ============================================
# 时区配置
# ============================================
USER_TIMEZONE=Asia/Shanghai
TIME_FORMAT=24

# ============================================
# Redis 配置 (用于流式回复持久化)
# ============================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=600

# ============================================
# Odoo 监控配置
# ============================================
ODOO_URL=https://q-vision.com.cn
ODOO_API_KEY=8a9cfde3dc56433679c135003f636d4204369d64
ODOO_DATABASE=atomsenses
ODOO_USERNAME=admin
ODOO_PASSWORD=8a9cfde3dc56433679c135003f636d4204369d64

